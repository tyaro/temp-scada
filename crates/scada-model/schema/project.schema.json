        },
        "bindings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/equipmentBinding"
          }
        }
      },
      "required": ["id", "typeId", "code", "name", "bindings"],
      "additionalProperties": false
    }
  }
