{
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "product": {
          "const": "banto-scada"
        },
        "schemaVersion": {
          "const": "0.24.0"
        },
        "projectId": {
          "$ref": "#/$defs/id"
        },
        "projectRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "minRuntimeVersion": {
          "const": "0.24.0"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "product",
        "schemaVersion",
        "projectId",
        "projectRevision",
        "minRuntimeVersion",
        "name"
      ],
      "additionalProperties": false
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "objects": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/primitive"
                },
                {
                  "$ref": "#/$defs/polyline"
                },
                {
                  "$ref": "#/$defs/symbolInstance"
                },
                {
                  "$ref": "#/$defs/imageInstance"
                },
                {
                  "$ref": "#/$defs/screenViewInstance"
                }
              ]
            }
          },
          "background": {
            "$ref": "#/$defs/color"
          },
          "folders": {
            "$ref": "#/$defs/layerFolders"
          },
          "backgroundImage": {
            "$ref": "#/$defs/backgroundImage"
          },
          "groups": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/$defs/geometricGroup"
            }
          }
        },
        "required": [
          "id",
          "name",
          "width",
          "height",
          "objects",
          "background",
          "folders",
          "groups"
        ],
        "additionalProperties": false
      }
    },
    "symbols": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "objects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/primitive"
                },
                {
                  "$ref": "#/$defs/polyline"
                }
              ]
            }
          },
          "folders": {
            "$ref": "#/$defs/layerFolders"
          }
        },
        "required": ["id", "name", "width", "height", "objects", "folders"],
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/imageAsset"
      }
    },
    "equipmentTypes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/equipmentType"
      }
    },
    "equipment": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/equipmentInstance"
      }
    }
  },
  "required": ["manifest", "screens", "symbols", "assets"],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "primitive": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "fill": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shape": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "rectangle"
                },
                "paint": {
                  "$ref": "#/$defs/shapePaint"
                }
              },
              "required": ["type", "paint"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "ellipse"
                },
                "paint": {
                  "$ref": "#/$defs/shapePaint"
                }
              },
              "required": ["type", "paint"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "text"
                },
                "text": {
                  "type": "string",
                  "maxLength": 1000,
                  "not": {
                    "pattern": "[\\r\\n\\u2028\\u2029]"
                  }
                },
                "binding": {
                  "$ref": "#/$defs/tagBinding"
                },
                "style": {
                  "$ref": "#/$defs/textStyle"
                }
              },
              "required": ["type", "text", "style"],
              "additionalProperties": false
            }
          ]
        },
        "name": {
          "$ref": "#/$defs/placementName"
        },
        "locked": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "folderId": {
          "$ref": "#/$defs/id"
        },
        "rotation": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "colorAlpha": {
          "$ref": "#/$defs/opacity"
        }
      },
      "required": [
        "id",
        "order",
        "x",
        "y",
        "width",
        "height",
        "shape",
        "rotation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "shape": {
                "properties": {
                  "type": {
                    "enum": ["rectangle", "ellipse"]
                  }
                },
                "type": "object"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["fill"]
                },
                {
                  "required": ["colorAlpha"]
                }
              ]
            }
          },
          "else": {
            "required": ["fill"]
          }
        }
      ]
    },
    "polyline": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "fill": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "shape": {
          "type": "object",
          "properties": {
            "type": {
              "const": "polyline"
            },
            "points": {
              "type": "array",
              "minItems": 2,
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -1000000,
                    "maximum": 1000000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                },
                "required": ["x", "y"],
                "additionalProperties": false
              }
            },
            "strokeWidth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 64
            },
            "arrow": {
              "enum": ["none", "end"]
            },
            "lineStyle": {
              "$ref": "#/$defs/lineStyle"
            }
          },
          "required": ["type", "points", "strokeWidth", "arrow"],
          "additionalProperties": false
        },
        "name": {
          "$ref": "#/$defs/placementName"
        },
        "locked": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "folderId": {
          "$ref": "#/$defs/id"
        },
        "rotation": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "colorAlpha": {
          "$ref": "#/$defs/opacity"
        }
      },
      "required": ["id", "order", "x", "y", "fill", "shape", "rotation"],
      "additionalProperties": false
    },
    "symbolInstance": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "fill": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shape": {
          "type": "object",
          "properties": {
            "type": {
              "const": "symbol"
            },
            "symbolId": {
              "$ref": "#/$defs/id"
            },
            "colorMode": {
              "enum": ["monochrome", "definition"]
            },
            "equipmentId": {
              "$ref": "#/$defs/id"
            }
          },
          "required": ["type", "symbolId", "colorMode"],
          "additionalProperties": false
        },
        "name": {
          "$ref": "#/$defs/placementName"
        },
        "locked": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "folderId": {
          "$ref": "#/$defs/id"
        },
        "rotation": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "colorAlpha": {
          "$ref": "#/$defs/opacity"
        }
      },
      "required": [
        "id",
        "order",
        "x",
        "y",
        "fill",
        "width",
        "height",
        "shape",
        "rotation"
      ],
      "additionalProperties": false
    },
    "tagBinding": {
      "type": "object",
      "properties": {
        "externalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        }
      },
      "required": ["externalName"],
      "additionalProperties": false
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "placementName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "allOf": [
        {
          "pattern": "^[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000\\ufeff](?:.*[^\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000\\ufeff])?$"
        },
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]"
          }
        }
      ]
    },
    "layerFolder": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/placementName"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parentId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": ["id", "name", "order"],
      "additionalProperties": false
    },
    "layerFolders": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/layerFolder"
      }
    },
    "shapePaint": {
      "type": "object",
      "properties": {
        "stroke": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "color": {
                  "$ref": "#/$defs/color"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 64
                },
                "lineStyle": {
                  "$ref": "#/$defs/lineStyle"
                },
                "alpha": {
                  "$ref": "#/$defs/opacity"
                }
              },
              "required": ["color", "width"],
              "additionalProperties": false
            }
          ]
        },
        "fill": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "paint": {
              "$ref": "#/$defs/fillPaint"
            }
          },
          "required": ["enabled", "paint"],
          "additionalProperties": false
        }
      },
      "required": ["fill", "stroke"],
      "additionalProperties": false
    },
    "textStyle": {
      "type": "object",
      "properties": {
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 512
        },
        "fontWeight": {
          "enum": ["normal", "bold"]
        },
        "align": {
          "enum": ["left", "center", "right"]
        }
      },
      "required": ["fontSize", "fontWeight", "align"],
      "additionalProperties": false
    },
    "lineStyle": {
      "enum": ["solid", "dashed", "dotted"]
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "imageAsset": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mime": {
          "enum": ["image/png", "image/jpeg"]
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "sha256",
        "mime",
        "byteLength",
        "width",
        "height",
        "name"
      ],
      "additionalProperties": false
    },
    "backgroundImage": {
      "type": "object",
      "properties": {
        "assetId": {
          "$ref": "#/$defs/id"
        },
        "fit": {
          "enum": ["contain", "cover", "stretch", "original"]
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        }
      },
      "required": ["assetId", "fit", "opacity"],
      "additionalProperties": false
    },
    "imageInstance": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "fill": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shape": {
          "type": "object",
          "properties": {
            "type": {
              "const": "image"
            },
            "assetId": {
              "$ref": "#/$defs/id"
            },
            "fit": {
              "enum": ["contain"]
            },
            "crop": {
              "$ref": "#/$defs/imageCrop"
            }
          },
          "required": ["type", "assetId", "fit"],
          "additionalProperties": false
        },
        "name": {
          "$ref": "#/$defs/placementName"
        },
        "locked": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "folderId": {
          "$ref": "#/$defs/id"
        },
        "rotation": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        }
      },
      "required": [
        "id",
        "order",
        "x",
        "y",
        "fill",
        "width",
        "height",
        "shape",
        "rotation"
      ],
      "additionalProperties": false
    },
    "paintColor": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "alpha": {
          "$ref": "#/$defs/opacity"
        }
      },
      "required": ["color", "alpha"],
      "additionalProperties": false
    },
    "fillPaint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "solid"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "alpha": {
              "$ref": "#/$defs/opacity"
            }
          },
          "required": ["type", "color", "alpha"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "linearGradient"
            },
            "angle": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            "start": {
              "$ref": "#/$defs/paintColor"
            },
            "end": {
              "$ref": "#/$defs/paintColor"
            }
          },
          "required": ["type", "angle", "start", "end"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "pattern"
            },
            "kind": {
              "enum": ["hatch", "crosshatch", "dots"]
            },
            "spacing": {
              "type": "number",
              "minimum": 2,
              "maximum": 1024
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 64
            },
            "angle": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            "foreground": {
              "$ref": "#/$defs/paintColor"
            },
            "background": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/paintColor"
                }
              ]
            }
          },
          "required": [
            "type",
            "kind",
            "spacing",
            "size",
            "angle",
            "foreground",
            "background"
          ],
          "additionalProperties": false
        }
      ]
    },
    "screenViewInstance": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shape": {
          "type": "object",
          "properties": {
            "type": {
              "const": "screenView"
            },
            "screenId": {
              "$ref": "#/$defs/id"
            },
            "fit": {
              "const": "contain"
            }
          },
          "required": ["type", "screenId", "fit"],
          "additionalProperties": false
        },
        "name": {
          "$ref": "#/$defs/placementName"
        },
        "locked": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "folderId": {
          "$ref": "#/$defs/id"
        },
        "rotation": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        }
      },
      "required": [
        "id",
        "order",
        "x",
        "y",
        "width",
        "height",
        "shape",
        "rotation"
      ],
      "additionalProperties": false
    },
    "imageCrop": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false
    },
    "geometricGroup": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/placementName"
        },
        "memberIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": ["id", "memberIds"],
      "additionalProperties": false
    },
    "equipmentSlot": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "not": {
            "pattern": "[^A-Za-z0-9_]"
          }
        },
        "type": {
          "enum": ["bool", "number"]
        },
        "direction": {
          "const": "read"
        }
      },
      "required": ["name", "type", "direction"],
      "additionalProperties": false
    },
    "equipmentType": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/placementName"
        },
        "slots": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/equipmentSlot"
          }
        }
      },
      "required": ["id", "name", "slots"],
      "additionalProperties": false
    },
    "equipmentBinding": {
      "type": "object",
      "properties": {
        "slotName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "not": {
            "pattern": "[^A-Za-z0-9_]"
          }
        },
        "externalName": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
            }
          ]
        }
      },
      "required": ["slotName", "externalName"],
      "additionalProperties": false
    },
    "equipmentInstance": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "typeId": {
          "$ref": "#/$defs/id"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:/-]"
          }
        },
        "name": {
