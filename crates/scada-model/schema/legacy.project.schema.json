{
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "product": {
          "const": "banto-scada"
        },
        "schemaVersion": {
          "const": "0.1.0"
        },
        "projectId": {
          "$ref": "#/$defs/id"
        },
        "projectRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "minRuntimeVersion": {
          "const": "0.1.0"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "product",
        "schemaVersion",
        "projectId",
        "projectRevision",
        "minRuntimeVersion",
        "name"
      ],
      "additionalProperties": false
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "objects": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "order": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "fill": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "shape": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "rectangle"
                        }
                      },
                      "required": ["type"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "ellipse"
                        }
                      },
                      "required": ["type"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "text"
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 1000
                        }
                      },
                      "required": ["type", "text"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "id",
                "order",
                "x",
                "y",
                "width",
                "height",
                "fill",
                "shape"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "name", "width", "height", "objects"],
        "additionalProperties": false
      }
    }
  },
  "required": ["manifest", "screens"],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
