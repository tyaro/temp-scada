{
  "description": "Read-only receiver display and original terminal scenarios; test command DSL only.",
  "scenarios": [
    {
      "name": "initial readout is frozen none without authority",
      "steps": [
        {
          "op": "observe",
          "display": {
            "snapshotRelation": "none",
            "transportConnected": false,
            "receiverStatus": "awaitingAttach",
            "receiverStoppedReason": null,
            "generation": null,
            "ownerClosed": false,
            "nativeRecoveryRequired": false,
            "authorizationLost": false,
            "highwater": null,
            "snapshot": null
          }
        }
      ]
    },
    {
      "name": "provisional evidence is not displayed or an original terminal",
      "steps": [
        {
          "op": "connect",
          "value": true
        },
        {
          "op": "beginAttach",
          "id": "a",
          "after": null
        },
        {
          "op": "state",
          "id": "a",
          "ref": "s",
          "rev": 3,
          "display": {
            "snapshotRelation": "none",
            "snapshot": null
          }
        },
        {
          "op": "attachTerminal",
          "id": "a",
          "value": {
            "kind": "pending",
            "request": {
              "attachId": "a"
            }
          }
        },
        {
          "op": "attach",
          "id": "a",
          "rev": 1,
          "ref": "s",
          "display": {
            "snapshotRelation": "currentSubscription",
            "highwater": 3,
            "snapshot": {
              "revision": 3
            }
          }
        },
        {
          "op": "attachTerminal",
          "id": "a",
          "value": {
            "kind": "terminal",
            "reply": {
              "outcome": {
                "kind": "attached",
                "snapshot": {
                  "revision": 1
                }
              }
            }
          }
        }
      ]
    },
