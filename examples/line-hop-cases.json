      "valid": true
    },
    {
      "name": "false は保存しない",
      "owner": "screens",
      "set": { "lineHops": false },
      "valid": false
    },
    {
      "name": "真偽値以外は不正",
      "owner": "screens",
      "set": { "lineHops": "on" },
      "valid": false
    },
    {
      "name": "Symbol 定義には置けない",
      "owner": "symbols",
      "set": { "lineHops": true },
      "valid": false
    }
  ]
