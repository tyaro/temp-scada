{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "contextId",
    "historianNamespace",
    "projectId",
    "projectRevision",
    "series"
  ],
  "properties": {
    "version": { "const": 3 },
    "historianNamespace": { "$ref": "#/$defs/id" },
    "kind": { "const": "historyContext" },
    "contextId": { "$ref": "#/$defs/id" },
    "projectId": { "type": "string" },
    "projectRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "series": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seriesId", "label"],
        "properties": {
          "seriesId": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 512 },
          "live": { "$ref": "#/$defs/live" },
          "liveUnavailable": { "enum": ["recorderStopped"] }
        },
        "oneOf": [
          { "required": ["live"], "not": { "required": ["liveUnavailable"] } },
          { "required": ["liveUnavailable"], "not": { "required": ["live"] } }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "$ref": "https://temp-scada.invalid/schema/history-contract-v1.json#/$defs/id"
    },
    "live": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segmentId", "valueType", "unit", "periodMs"],
      "properties": {
        "segmentId": { "$ref": "#/$defs/id" },
        "valueType": {
          "$ref": "https://temp-scada.invalid/schema/history-contract-v1.json#/$defs/identity/properties/valueType"
        },
        "unit": {
          "$ref": "https://temp-scada.invalid/schema/history-contract-v1.json#/$defs/identity/properties/unit"
        },
        "periodMs": {
          "$ref": "https://temp-scada.invalid/schema/history-contract-v1.json#/$defs/identity/properties/periodMs"
        }
      }
    }
  }
}
