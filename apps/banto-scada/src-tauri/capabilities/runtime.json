{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "runtime",
  "description": "The Runtime window: the Runtime-only and shared commands only. No plugin permission and no window or webview creation (Runtime mode design §4).",
  "windows": ["runtime"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-title",
    "allow-app-mode",
    "allow-app-close-reply",
    "allow-hub-disconnect",
    "allow-hub-read-stop",
    "allow-hub-saved-endpoint",
    "allow-alarm-snapshot",
    "allow-alarm-ack",
    "allow-alarm-buzzer-silence",
    "allow-alarm-history",
    "allow-alarm-sound-test",
    "allow-alarm-settings-get",
    "allow-alarm-settings-set",
    "allow-alarm-sound-reset",
    "allow-auth-status",
    "allow-auth-phase",
    "allow-auth-login",
    "allow-auth-logout",
    "allow-auth-resolve",
    "allow-auth-change-password",
    "allow-auth-setup",
    "allow-users-list",
    "allow-users-create",
    "allow-users-update",
    "allow-users-reset-password",
    "allow-users-delete",
    "allow-auth-config-get",
    "allow-history-query",
    "allow-history-cancel",
    "allow-recording-status",
    "allow-recording-slot"
  ]
}
